# Safe template — replace angle-bracket placeholders; never commit a real `.env`.

# --- API ---
# DATABASE_URL (required for local `uv run`): async PostgreSQL URL for SQLAlchemy + asyncpg.
# Example (local Postgres): postgresql+asyncpg://postgres:postgres@localhost:5432/dashboardy
# Example (Supabase — use values from Project Settings → Database; use Session pooler or direct):
#   postgresql+asyncpg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASS>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# API_DATABASE_URL (optional, Docker Compose API service only): When set, overrides the
# default bundled Compose Postgres so the API container uses this URL as DATABASE_URL.
# Point it at the same Supabase Postgres as your project so app tables + Vault RPCs stay
# in sync; leave unset to use the local `postgres:` service in ops/docker-compose.yml.
# Interpolation runs on the host — use: docker compose --env-file .env -f ops/docker-compose.yml up
# API_DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<PASSWORD>@...

# ENVIRONMENT (required): runtime environment name. Allowed: local | staging | production (extend as needed for your org).
ENVIRONMENT=local

# LOG_LEVEL (optional, default=info): API log verbosity (e.g. debug, info, warning, error).
LOG_LEVEL=info

# Supabase JWT verification (required for API startup; used by auth dependencies on protected routes).
# Use ONE of:
# - RS256 (recommended when available): set SUPABASE_JWKS_URL
# - HS256: set SUPABASE_JWT_SECRET (Project Settings → API → JWT Secret)
SUPABASE_JWKS_URL=https://<PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=<SUPABASE_JWT_SECRET>
SUPABASE_JWT_ISSUER=https://<PROJECT_REF>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE (optional): set to your JWT `aud` claim when you want strict audience checks.
# SUPABASE_JWT_AUDIENCE=authenticated

# Query engine (optional, Feature 004): defaults match specs/004-query-engine/tasks.md.
# Constraints (enforced at API startup): DEFAULT_MAX_ROWS ≤ HARD_MAX_ROWS; each TTL_* ≤ GLOBAL_TTL_CEILING.
# QUERY_ENGINE_SNOWFLAKE_STATEMENT_TIMEOUT_SECONDS=30
# QUERY_ENGINE_DEFAULT_MAX_ROWS=5000
# QUERY_ENGINE_HARD_MAX_ROWS=10000
# QUERY_ENGINE_CONCURRENT_SNOWFLAKE_EXECUTIONS=10
# QUERY_ENGINE_WAITING_REQUESTS_QUEUE_DEPTH=50
# QUERY_ENGINE_EXECUTION_SLOT_WAIT_SECONDS=25
# QUERY_ENGINE_CACHE_TTL_KPI_SECONDS=600
# QUERY_ENGINE_CACHE_TTL_CHART_SECONDS=300
# QUERY_ENGINE_CACHE_TTL_TABLE_SECONDS=120
# QUERY_ENGINE_CACHE_GLOBAL_TTL_CEILING_SECONDS=900
# QUERY_ENGINE_AUDIT_RETENTION_DAYS=90

# --- Web ---
# API_PUBLIC_URL (required): browser- and server-side base URL for calling the API in this environment.
API_PUBLIC_URL=http://localhost:8000

# NEXT_PUBLIC_SUPABASE_ANON_KEY / NEXT_PUBLIC_SUPABASE_URL (required for web auth): from Supabase project settings.
# Used by `ops/docker-compose.yml` for the `web` service via variable substitution (not full-repo env_file).
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co

# --- Admin invites (API) ---
# Needed for `POST /workspaces/{workspace_id}/members` to invite by email via Supabase Admin API.
# You can reuse NEXT_PUBLIC_SUPABASE_URL; the API will fall back to it if SUPABASE_URL is unset.
# SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# WEB_PUBLIC_URL (optional): public canonical URL of the web app (e.g. for links or callbacks). Omit if not used yet.
WEB_PUBLIC_URL=http://localhost:3000
